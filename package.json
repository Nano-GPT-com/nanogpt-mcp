{
  "name": "@nanogpt/mcp",
  "version": "1.5.1",
  "description": "MCP server for NanoGPT: chat, image, video, 3D, audio, web search and scraping tools for AI agents",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano-GPT-com/nanogpt-mcp.git"
  },
  "homepage": "https://github.com/Nano-GPT-com/nanogpt-mcp#readme",
  "bugs": {
    "url": "https://github.com/Nano-GPT-com/nanogpt-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "nanogpt-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76",
    "lru-cache": "^11.0.2",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist/**/*"
  ],
  "overrides": {
    "qs": "^6.14.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nanogpt",
    "ai",
    "llm",
    "claude-code",
    "image-generation",
    "video-generation",
    "3d-generation"
  ],
  "license": "MIT"
}
